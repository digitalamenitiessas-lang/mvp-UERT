# Desarrollo: no hace falta ninguna variable. Sin DATABASE_URL se usa PGlite
# (Postgres embebido) en ~/.mvp-uert/pglite y la primera vez se cargan solos
# el esquema y los datos de la demo.
#
# Para usar un PostgreSQL propio:
# DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/uert
# DB_POOL_MAX=5
#
# Para cambiar la carpeta de PGlite:
# PGLITE_DIR=/ruta/a/carpeta
#
# Para servir la app debajo de una ruta (en la VPS: /uert). Se fija en el
# build; si se cambia, hay que volver a compilar:
# NEXT_PUBLIC_BASE_PATH=/uert
#
# En la VPS las variables están en /etc/uert/app.env (ver deploy/instalar.sh).
